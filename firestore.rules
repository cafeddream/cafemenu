rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null;
    }

    function validTable(tableId) {
      return tableId.matches('^T(1[0-5]|[1-9])$');
    }

    function validOrderItems(items) {
      return items is list && items.size() > 0 && items.size() <= 80;
    }

    function customerPaymentUpdate() {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'paymentStatus',
            'preferredPaymentMethod',
            'paymentClaimedAt',
            'cashRequestedAt',
            'updatedAt'
          ]);
    }

    function customerOrderWrite() {
      let data = request.resource.data;
      return data.tableId == tableId
        && data.placedBy == 'customer'
        && data.status in ['new', 'preparing', 'served']
        && validOrderItems(data.items)
        && data.paymentStatus in ['pending', 'customer_claimed_paid', 'cash_at_counter'];
    }

    match /orders/{tableId}/current/order {
      allow read: if validTable(tableId);
      allow create: if validTable(tableId) && customerOrderWrite();
      allow update: if validTable(tableId) && (
        (isStaff()) ||
        (customerPaymentUpdate()) ||
        (customerOrderWrite())
      );
      allow delete: if validTable(tableId) && isStaff();
    }

    match /dailySummaries/{dateKey} {
      allow read: if isStaff();
      allow write: if isStaff();

      match /payments/{paymentId} {
        allow read, write: if isStaff();
      }
    }

    match /tableHistory/{tableId}/orders/{orderId} {
      allow read: if isStaff() && validTable(tableId);
      allow write: if isStaff() && validTable(tableId);
    }

    match /auditLog/{entryId} {
      allow read, create: if isStaff();
    }
  }
}
