rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validTable(tableId) {
      return tableId in [
        "T1", "T2", "T3", "T4", "T5",
        "T6", "T7", "T8", "T9", "T10",
        "T11", "T12", "T13", "T14", "T15"
      ];
    }

    function validPublicCreate(tableId) {
      return validTable(tableId)
        && request.resource.data.tableId == tableId
        && request.resource.data.status == "new"
        && request.resource.data.paymentStatus == "pending"
        && request.resource.data.total is number
        && request.resource.data.items is list;
    }

    function validPublicUpdate(tableId) {
      return validTable(tableId)
        && resource.data.status != "paid"
        && request.resource.data.tableId == tableId
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "items",
          "total",
          "paymentStatus",
          "preferredPaymentMethod",
          "paymentClaimedAt",
          "cashRequestedAt",
          "timestamp",
          "updatedAt"
        ])
        && request.resource.data.paymentStatus in ["pending", "customer_claimed_paid", "cash_at_counter"]
        && request.resource.data.total is number
        && request.resource.data.items is list;
    }

    match /orders/{tableId}/current/order {
      allow read: if signedIn();
      allow create: if signedIn() || validPublicCreate(tableId);
      allow update: if signedIn() || validPublicUpdate(tableId);
      allow delete: if signedIn();
    }

    match /dailySummaries/{document=**} {
      allow read, write: if signedIn();
    }

    match /tableHistory/{document=**} {
      allow read, write: if signedIn();
    }
  }
}
