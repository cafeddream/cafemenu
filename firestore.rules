rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null;
    }

    function validTable(tableId) {
      return tableId.matches('^T(1[0-5]|[1-9])$');
    }

    function validOrderItems(items) {
      return items is list && items.size() > 0 && items.size() <= 80;
    }

    function validCustomerStatus() {
      let status = request.resource.data.status;
      return status == 'new' || status == 'preparing' || status == 'served';
    }

    function validCustomerProfile() {
      let data = request.resource.data;
      return data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 60
        && data.customerMobile is string
        && data.customerMobile.matches('^[6-9][0-9]{9}$')
        && data.customerMobileNormalized is string
        && data.customerMobileNormalized == data.customerMobile;
    }

    function customerPlacesOrder() {
      let data = request.resource.data;
      return data.tableId == tableId
        && data.placedBy == 'customer'
        && validOrderItems(data.items)
        && validCustomerStatus()
        && validCustomerProfile()
        && data.status != 'paid';
    }

    function customerPaymentUpdate() {
      return resource != null
        && request.resource.data.placedBy == resource.data.placedBy
        && request.resource.data.paymentStatus == 'customer_claimed_paid'
        && request.resource.data.preferredPaymentMethod == 'online'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'paymentStatus',
            'preferredPaymentMethod',
            'paymentClaimedAt',
            'updatedAt'
          ]);
    }

    match /orders/{tableId}/current/order {
      allow read: if validTable(tableId);
      allow create: if validTable(tableId) && (isStaff() || customerPlacesOrder());
      allow update: if validTable(tableId) && (
        isStaff() ||
        customerPlacesOrder() ||
        customerPaymentUpdate()
      );
      allow delete: if validTable(tableId) && isStaff();
    }

    match /dailySummaries/{dateKey} {
      allow read: if isStaff();
      allow write: if isStaff();

      match /payments/{paymentId} {
        allow read, write: if isStaff();
      }
    }

    match /tableHistory/{tableId}/orders/{orderId} {
      allow read: if isStaff() && validTable(tableId);
      allow write: if isStaff() && validTable(tableId);
    }

    match /auditLog/{entryId} {
      allow read, create: if isStaff();
    }
  }
}
