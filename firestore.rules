rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null;
    }

    function validTable(tableId) {
      let runtimePath = /databases/$(database)/documents/appConfig/runtime;
      return (exists(runtimePath)
        && get(runtimePath).data.allowedTables is list
        && tableId in get(runtimePath).data.allowedTables)
        || tableId in [
        'PS 1', 'PS 2', 'PS 3', 'PS 4', 'PS 5', 'PS 6', 'PS 7', 'PS 8', 'PS 9', 'PS 10',
        'COUNTER'
      ];
    }

    function validOrderItems(items) {
      return items is list && items.size() > 0 && items.size() <= 80;
    }

    function validStaffSessionHoldOrder() {
      let data = request.resource.data;
      return data.placedBy == 'counter'
        && data.paymentStatus == 'session_hold'
        && data.privateSessionId is string
        && data.privateSessionId.size() > 0
        && validTable(data.tableId)
        && validOrderItems(data.items)
        && data.status == 'new';
    }

    function staffCreatesOrder() {
      return isStaff() && (
        !('paymentStatus' in request.resource.data)
        || request.resource.data.paymentStatus != 'session_hold'
        || validStaffSessionHoldOrder()
      );
    }

    match /activeOrders/{orderId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isStaff();
    }

    match /orders/{tableId}/current/order {
      allow read: if validTable(tableId);
      allow create, update, delete: if validTable(tableId) && isStaff();
    }

    match /receipts/{orderId} {
      allow get: if true;
      allow list, create, update, delete: if isStaff();
    }

    match /dailySummaries/{dateKey} {
      allow read: if isStaff();
      allow write: if isStaff();

      match /payments/{paymentId} {
        allow read, write: if isStaff();
      }
    }

    match /tableHistory/{tableId}/orders/{orderId} {
      allow read: if isStaff() && validTable(tableId);
      allow write: if isStaff() && validTable(tableId);
    }

    match /auditLog/{entryId} {
      allow read, create, delete: if isStaff();
    }

    match /privateSessions/{sessionId} {
      allow read, create, update, delete: if isStaff();
    }

    match /appConfig/security {
      allow read, write: if isStaff();
    }

    match /appConfig/runtime {
      allow read: if true;
      allow write: if isStaff();
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /reportArchive/{dateKey} {
      allow read, write: if isStaff();
    }
  }
}
